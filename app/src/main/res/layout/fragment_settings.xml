<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.auth.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header with back button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/settingsProfileImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:scaleType="centerCrop" />

        <Button
            android:id="@+id/changeProfilePictureButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:text="Change profile picture" />
        <!-- Username -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/username_input"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_marginHorizontal="30dp" />

        <EditText
            android:id="@+id/settingsUsernameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/username_input"
            android:background="@drawable/round_edit_text_background"
            android:padding="10dp"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="12dp"
            android:inputType="textPersonName" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/email"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_marginHorizontal="30dp" />

        <EditText
            android:id="@+id/settingsEmailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/email"
            android:background="@drawable/round_edit_text_background"
            android:padding="10dp"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="12dp"
            android:inputType="textEmailAddress" />

        <!-- New Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_password"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_marginHorizontal="30dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="12dp"
            app:passwordToggleEnabled="true"
            app:hintEnabled="false">

            <EditText
                android:id="@+id/settingsPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/round_edit_text_background"
                android:hint="@string/new_password_hint"
                android:padding="10dp"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:autofillHints=""/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bio"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_marginHorizontal="30dp" />

        <EditText
            android:id="@+id/settingsBioInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bio_hint"
            android:background="@drawable/round_edit_text_background"
            android:padding="10dp"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="24dp"
            android:minLines="3"
            android:gravity="top|start"
            android:inputType="textMultiLine" />

        <!-- Save button -->
        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/loginn_and_create_account_background"
            android:text="@string/save_settings" />

        <!-- Logout button -->
        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/loginn_and_create_account_background"
            android:text="@string/logout" />

        <!-- Delete account button -->
        <Button
            android:id="@+id/deleteAccountButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#D32F2F"
            android:textColor="@color/white"
            android:text="@string/delete_account" />

    </LinearLayout>

</ScrollView>